# Configure no ambiente Vercel com as credenciais públicas do projeto usado pelo plugin SketchUp.
# Não use mock ou qualquer chave privada em produção.
VITE_API=supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Compatibilidade com projetos que ainda usam a chave JWT antiga:
# VITE_SUPABASE_ANON_KEY=
